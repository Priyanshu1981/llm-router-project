# Copy this file to ".env" and fill in your real values.
# Do not put quotes around values and do not put spaces around "=".

# --- Groq API ---
GROQ_API_KEY=paste_your_key_here

# --- Models ---
SMALL_MODEL=openai/gpt-oss-20b
LARGE_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Tunable thresholds ---
# Cache returns a stored answer if similarity is at or above this value
CACHE_THRESHOLD=0.90
# Router sends a query to the small model if P(easy) is at or above this value
ROUTER_THRESHOLD=0.75

# --- Prices in USD per 1 million tokens ---
# We will fill these in during Phase 2 from Groq's pricing page.
SMALL_INPUT_PRICE_PER_M=0.0
SMALL_OUTPUT_PRICE_PER_M=0.0
LARGE_INPUT_PRICE_PER_M=0.0
LARGE_OUTPUT_PRICE_PER_M=0.0